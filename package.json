{
  "name": "opencode-memsearch",
  "version": "1.0.0",
  "description": "Persistent cross-session memory for OpenCode, powered by memsearch",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "opencode-memsearch": "scripts/cli.ts"
  },
  "files": [
    "dist",
    "src/daemon-client.ts",
    "src/memory.ts",
    "src/service.ts",
    "scripts/cli.ts",
    "scripts/lib.ts",
    "scripts/memsearch-daemon.py",
    "scripts/reindex.ts",
    "scripts/seed-memories.ts"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --packages external && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "bun test"
  },
  "keywords": [
    "opencode",
    "memory",
    "memsearch",
    "ai",
    "coding",
    "persistent-memory",
    "semantic-search"
  ],
  "author": "Jeremy Dormitzer <jeremy.dormitzer@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdormit/opencode-memsearch.git"
  },
  "bugs": {
    "url": "https://github.com/jdormit/opencode-memsearch/issues"
  },
  "homepage": "https://github.com/jdormit/opencode-memsearch#readme",
  "dependencies": {
    "@opencode/client": "^2.0.29",
    "@opencode/plugin": "^2.0.29"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "typescript": "^5.8.0"
  }
}
